# Copy thành .env (đã bị .gitignore). Không commit khoá thật.

# Thứ tự thử LLM; lỗi provider đầu thì chuyển sang provider sau.
LLM_ORDER=groq,gemini
# Nhiều khoá cách nhau bằng dấu phẩy, agent xoay vòng.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=6

# Đặt giá trị thì mọi request /chat phải gửi header X-Agent-Key (dùng cho n8n qua ngrok).
AGENT_API_KEY=

# Origin của web được gọi agent từ trình duyệt.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Tuỳ chọn: đổi nguồn dữ liệu (mặc định lấy trong data/ của repo).
# SHOWBIZ_FILE=
# EDUCATION_FILE=
# INSIGHTS_FILE=
